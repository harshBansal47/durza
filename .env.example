# Store application logs in the database (browse at /admin > App Logs, or
# GET /api/v1/admin/logs/stats) and delete them automatically after the
# retention period. Left commented: a blank value fails to parse for these.
# LOG_STORE_ENABLED=true
# LOG_STORE_MIN_LEVEL=INFO
# LOG_RETENTION_DAYS=14
# LOG_SCRUB_INTERVAL_HOURS=6
# SLOW_REQUEST_SECONDS=2.0
METRICS_ENABLED=

# ---- Scheduler & deal alerts -------------------------------------------------
# Nothing scheduled runs unless this is true: no alerts, no coupon expiry, no
# verification, no ingestion refresh.
SCHEDULER_ENABLED=false
# Which jobs to run when it is on (comma-separated; empty = all). To switch on
# only follow/track alerts and expiry, without ingestion or verification:
#   SCHEDULER_JOBS=send_deal_alerts,send_alerts,expire_coupons
SCHEDULER_JOBS=
# DEAL_ALERT_WINDOW_DAYS=7
# DEAL_ALERT_ENDING_SOON_HOURS=48
# DEAL_ALERT_MIN_HOURS_BETWEEN_EMAILS=24
# DEAL_ALERT_MAX_ITEMS=6
